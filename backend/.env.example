# Puerto HTTP donde Express escuchara peticiones.
PORT=5000

# URL de MongoDB local. MongoDB Compass tambien puede conectarse a esta URL.
MONGO_URI=mongodb://127.0.0.1:27017/polibarber

# Secreto JWT. En produccion debe ser largo, privado y diferente.
JWT_SECRET=polibarber_super_secret_cambiar_en_produccion

# Tiempo de vida del token del administrador.
JWT_EXPIRES_IN=8h

# Origen permitido para CORS durante desarrollo con Vite.
CLIENT_URL=http://localhost:5173

# Credenciales iniciales del administrador solicitadas.
ADMIN_USER=admin
ADMIN_PASSWORD=poli123
